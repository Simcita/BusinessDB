# App
PORT=5000
NODE_ENV=production

# Database (Supabase)
DATABASE_URL=postgresql://...
DIRECT_URL=postgresql://...

# IMAP (privateemail.com)
IMAP_HOST=mail.privateemail.com
IMAP_PORT=993
IMAP_USER=your@email.com
IMAP_PASS=yourpassword

# Email delivery (Resend)
RESEND_API_KEY=re_...
# Use the mail subdomain to keep Resend isolated from privateemail.com DNS
EMAIL_FROM=noreply@mail.sharesworldwide.trade

# WhatsApp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Frontend
FRONTEND_URL=https://yourdomain.com
WHOP_LINK=https://whop.com/...

# Auth
JWT_SECRET=change_me_in_production

# Worker scheduling
# Cron expression for email polling, verification, and fulfillment workers.
# Default: every 15 minutes. Change to */1 * * * * for every-minute polling in dev.
POLL_CRON_SCHEDULE=*/15 * * * *

# Optional override for the Gmail worker specifically — takes priority over
# POLL_CRON_SCHEDULE for that worker only (verification/fulfillment workers are
# unaffected). Useful to temporarily speed up email polling around a live event
# without touching the other workers. Leave unset to fall back to POLL_CRON_SCHEDULE.
# GMAIL_POLL_CRON=*/5 * * * *

# Set to "true" to disable email polling (IMAP) without redeploying.
DISABLE_EMAIL_POLLING=false

# Set to "true" to disable verification + fulfillment job processing without redeploying.
DISABLE_JOB_PROCESSING=false

# XM Affiliate
# AFFILIATE_CODE is the general public signup code. TOUR_AFFILIATE_CODE is used
# only on tour-specific surfaces (Livestream Waitlist, Door Check). Both share
# the same registration link.
AFFILIATE_CODE=BANDISHARES05
TOUR_AFFILIATE_CODE=UNITOUR
AFFILIATE_LINK=https://clicks.pipaffiliates.com/c?c=1264888&l=en&p=1

# Whop community links (used in the welcome email)
WHOP_BOOTCAMP_LINK=https://whop.com/bandi-shares-educational-program/bootacamp/
WHOP_DISCUSSION_LINK=https://whop.com/bandi-shares-educational-program/trade-discussion-xm-copy/
# Set this once the setup video is published
VIDEO_LINK=

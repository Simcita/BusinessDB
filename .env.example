# App
PORT=5000
NODE_ENV=production

# Database (Supabase)
DATABASE_URL=postgresql://...
DIRECT_URL=postgresql://...

# IMAP (privateemail.com)
IMAP_HOST=mail.privateemail.com
IMAP_PORT=993
IMAP_USER=your@email.com
IMAP_PASS=yourpassword

# Email delivery (Resend)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# WhatsApp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Frontend
FRONTEND_URL=https://yourdomain.com
WHOP_LINK=https://whop.com/...

# Auth
JWT_SECRET=change_me_in_production

# Worker scheduling
# Cron expression for email polling, verification, and fulfillment workers.
# Default: every 15 minutes. Change to */1 * * * * for every-minute polling in dev.
POLL_CRON_SCHEDULE=*/15 * * * *

# Set to "true" to disable email polling (IMAP) without redeploying.
DISABLE_EMAIL_POLLING=false

# Set to "true" to disable verification + fulfillment job processing without redeploying.
DISABLE_JOB_PROCESSING=false

# XM Affiliate
# Referral code users must use when opening an XM account.
AFFILIATE_CODE=BANDISHARES05
# Full XM registration URL (the button link shown to users). Leave blank if not yet available.
AFFILIATE_LINK=
